      "parameters": {
        "jsCode": "const res = $input.first().json;\nconst users = Object.fromEntries((res.includes?.users ?? []).map((u) => [u.id, u.username]));\n\n// Si no hay tweets nuevos, el flujo se detiene aquí (no hay nada que analizar ni alertar)\nreturn (res.data ?? []).map((t) => ({\n  json: {\n    tweet_id: t.id,\n    fecha_hora: t.created_at,\n    autor: users[t.author_id] ? '@' + users[t.author_id] : t.author_id,\n    contenido: t.text,\n    idioma: t.lang ?? '',\n  },\n}));"
      },

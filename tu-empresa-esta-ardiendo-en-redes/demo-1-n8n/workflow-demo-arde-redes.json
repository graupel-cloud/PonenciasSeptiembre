        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: 'deepseek-v4.1-flash',\n  stream: false,\n  think: false,\n  format: 'json',\n  options: { temperature: 0 },\n  messages: [\n    { role: 'system', content: \"Eres un analista de sentimiento de redes sociales. Analiza el tweet y responde UNICAMENTE con un objeto JSON con exactamente estas claves: \\\"sentimiento\\\" (uno de: \\\"positivo\\\", \\\"negativo\\\", \\\"neutro\\\"), \\\"confianza\\\" (numero entre 0 y 1), \\\"tema\\\" (de que habla el tweet, maximo 8 palabras, en espanol), \\\"motivo\\\" (una frase breve en espanol que justifique la clasificacion).\" },\n    { role: 'user', content: 'Tweet: ' + $json.contenido }\n  ]\n}) }}",

    {
      "parameters": {
        "jsCode": "const UMBRAL_NEGATIVOS = 2;\n\nconst filas = $input.all().map((i) => i.json).filter((r) => r.tweet_id);\nconst negativos = filas.filter((r) => r.sentimiento === 'negativo');\n\n// Solo alertamos si en esta ejecución ha entrado algún negativo nuevo,\n// para no repetir el mismo email cada 15 minutos con los mismos tweets.\nconst nuevos = new Set($('Normalizar resultado').all().map((i) => i.json.tweet_id));\nconst hayNegativoNuevo = negativos.some((r) => nuevos.has(r.tweet_id));\n\nconst hora = (iso) => DateTime.fromISO(String(iso)).setZone('Europe/Madrid').toFormat('dd/MM HH:mm');\n\nreturn [{\n  json: {\n    alerta: negativos.length >= UMBRAL_NEGATIVOS && hayNegativoNuevo,\n    umbral: UMBRAL_NEGATIVOS,\n    total_tweets: filas.length,\n    total_negativos: negativos.length,\n    total_positivos: filas.filter((r) => r.sentimiento === 'positivo').length,\n    total_neutros: filas.filter((r) => r.sentimiento === 'neutro').length,\n    negativos: negativos.map((r) => ({\n      tweet_id: r.tweet_id,\n      hora: hora(r.fecha_hora),\n      autor: r.autor,\n      contenido: r.contenido,\n      tema: r.tema,\n      motivo: r.motivo,\n      url: `https://x.com/i/web/status/${r.tweet_id}`,\n    })),\n  },\n}];"
      },

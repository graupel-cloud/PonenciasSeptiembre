    {
      "parameters": {
        "method": "POST",
        "url": "https://ollama.com/api/chat",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: 'deepseek-v4.1-flash',\n  stream: false,\n  think: false,\n  format: 'json',\n  options: { temperature: 0.3 },\n  messages: [\n    { role: 'system', content: \"Eres un analista de reputacion online. Recibiras un resumen de tweets con el hashtag #graupel de la ultima hora y la lista de tweets clasificados como negativos. Redacta una alerta breve en espanol para el equipo. Responde UNICAMENTE con un objeto JSON con las claves: \\\"asunto\\\" (asunto del email, maximo 80 caracteres, debe incluir el numero de tweets negativos) y \\\"resumen_html\\\" (2 a 4 parrafos cortos en HTML usando solo <p>, <b> y <ul><li>, explicando cuantos negativos ha habido, de que estan hablando, los temas o quejas comunes y una recomendacion de accion).\" },\n    { role: 'user', content: JSON.stringify({\n        ventana: 'ultimos 60 minutos',\n        total_tweets: $json.total_tweets,\n        negativos: $json.total_negativos,\n        positivos: $json.total_positivos,\n        neutros: $json.total_neutros,\n        tweets_negativos: $json.negativos.map(t => ({ hora: t.hora, autor: t.autor, texto: t.contenido, tema: t.tema, motivo: t.motivo }))\n      }) }\n  ]\n}) }}",
        "options": {}
      },
      "id": "30cd6e46-ad6a-444f-bdfa-218be9cf7806",
      "name": "Ollama · Redactar alerta",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -2240,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "jsCode": "const d = $('Evaluar alerta').first().json;\nconst raw = $input.first().json.message?.content ?? '';\n\nlet ia = {};\ntry { ia = JSON.parse(raw); } catch (e) {\n  const m = raw.match(/\\{[\\s\\S]*\\}/);\n  if (m) { try { ia = JSON.parse(m[0]); } catch (e2) {} }\n}\n\nconst esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\nconst asunto = ia.asunto || `⚠️ #graupel: ${d.total_negativos} tweets negativos en la última hora`;\nconst resumen = ia.resumen_html || `<p>Se han detectado <b>${d.total_negativos}</b> tweets negativos sobre #graupel en los últimos 60 minutos.</p>`;\n\nconst filas = d.negativos.map((t) => `\n  <tr>\n    <td style=\"padding:6px;border-bottom:1px solid #eee;white-space:nowrap\">${esc(t.hora)}</td>\n    <td style=\"padding:6px;border-bottom:1px solid #eee\">${esc(t.autor)}</td>\n    <td style=\"padding:6px;border-bottom:1px solid #eee\">${esc(t.contenido)}<br><small style=\"color:#888\">${esc(t.tema)}</small></td>\n    <td style=\"padding:6px;border-bottom:1px solid #eee\"><a href=\"${t.url}\">Ver</a></td>\n  </tr>`).join('');\n\nconst html = `\n<div style=\"font-family:Arial,sans-serif;font-size:14px;color:#222;max-width:720px\">\n  <h2 style=\"color:#c0392b;margin-bottom:4px\">Alerta de sentimiento · #graupel</h2>\n  <p style=\"color:#666;margin-top:0\">Últimos 60 min: ${d.total_tweets} tweets · <b style=\"color:#c0392b\">${d.total_negativos} negativos</b> · ${d.total_neutros} neutros · ${d.total_positivos} positivos</p>\n  ${resumen}\n  <h3>Tweets negativos</h3>\n  <table style=\"border-collapse:collapse;width:100%;font-size:13px\">\n    <tr style=\"text-align:left;background:#f6f6f6\"><th style=\"padding:6px\">Hora</th><th style=\"padding:6px\">Autor</th><th style=\"padding:6px\">Tweet</th><th style=\"padding:6px\"></th></tr>\n    ${filas}\n  </table>\n</div>`;\n\nreturn [{ json: { asunto, html } }];"
      },

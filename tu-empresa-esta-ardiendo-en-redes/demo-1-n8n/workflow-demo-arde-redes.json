    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const tweet = $('¿Tweet nuevo?').item.json;\nconst raw = $json.message?.content ?? '';\n\nlet r = {};\ntry {\n  r = JSON.parse(raw);\n} catch (e) {\n  const m = raw.match(/\\{[\\s\\S]*\\}/);\n  if (m) { try { r = JSON.parse(m[0]); } catch (e2) {} }\n}\n\nconst s = String(r.sentimiento ?? '').toLowerCase().normalize('NFD').replace(/[\\u0300-\\u036f]/g, '');\nconst sentimiento = s.startsWith('neg') ? 'negativo' : s.startsWith('pos') ? 'positivo' : 'neutro';\nconst confianza = Math.min(1, Math.max(0, Number(r.confianza) || 0));\n\nreturn {\n  json: {\n    tweet_id: tweet.tweet_id,\n    fecha_hora: tweet.fecha_hora,\n    autor: tweet.autor,\n    contenido: tweet.contenido,\n    idioma: tweet.idioma,\n    sentimiento,\n    confianza,\n    tema: String(r.tema ?? ''),\n    motivo: String(r.motivo ?? ''),\n    analizado_en: new Date().toISOString(),\n  },\n};"
      },

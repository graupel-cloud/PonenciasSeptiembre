# =============================================================================
#  Copia este fichero como .env y rellénalo:   cp .env.example .env
#  El .env contiene secretos: no lo subas nunca al repositorio (.gitignore ya lo excluye).
#  Valores con caracteres especiales ($ # espacios): ponlos entre comillas simples '...'.
# =============================================================================

# ----------------------------------------------------------------------------- X (Twitter) API v2
# Bearer token de la app (developer.x.com > tu proyecto > Keys and tokens > Bearer Token).
# Úsalo tal cual te lo da X (puede contener %2F o %3D: no hay que decodificarlo).
X_BEARER_TOKEN=
# Regla del stream filtrado. Solo se lee, nunca se publica nada en X.
X_RULE_VALUE='#MiHashtagDemo -is:retweet'
# Etiqueta de la regla: el ingest solo crea o modifica la regla con esta etiqueta.
X_RULE_TAG=demo
# Segundos sin recibir nada (X manda una línea vacía cada 20 s) antes de cerrar y reconectar.
X_STALL_TIMEOUT_SECONDS=30
# false = no conectar a X (útil para probar solo con tools/simulate.py sin gastar crédito).
X_INGEST_ENABLED=true

# ----------------------------------------------------------------------------- Kafka
KAFKA_BOOTSTRAP=kafka:9092
# Solo la primera vez que arranca el job (sin offsets guardados): latest | earliest
KAFKA_START_FROM=latest

# ----------------------------------------------------------------------------- Ollama Cloud
# API key: https://ollama.com/settings/keys
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/api
# Modelos disponibles: curl -s https://ollama.com/api/tags
OLLAMA_MODEL=deepseek-v4.1-flash
# false = sin "pensamiento" (más rápido). Vacío = lo que decida el modelo.
OLLAMA_THINK=false

# ----------------------------------------------------------------------------- Lógica de alerta
BRAND_NAME=Panadería Demo
# Alerta cuando hay NEGATIVE_THRESHOLD negativos nuevos (no usados en una alerta anterior)
# en los últimos WINDOW_MINUTES minutos (por hora de publicación en X)...
NEGATIVE_THRESHOLD=2
WINDOW_MINUTES=60
# ...y como mucho una alerta cada COOLDOWN_MINUTES minutos.
COOLDOWN_MINUTES=5

# ----------------------------------------------------------------------------- Correo (SMTP)
SMTP_HOST=smtp.example.com
# 587 con STARTTLS (recomendado) o 465 con SSL directo (SMTP_STARTTLS se ignora en 465).
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=alertas@example.com
SMTP_PASSWORD=''
SMTP_FROM=alertas@example.com
# Varias direcciones separadas por comas.
ALERT_EMAIL_TO=equipo@example.com

# ----------------------------------------------------------------------------- Panel y hora
# Zona horaria del panel, de los correos y de los logs.
TZ=Europe/Madrid

# ----------------------------------------------------------------------------- Panel público (opcional)
# Por defecto el panel solo escucha en 127.0.0.1:8080 (se abre por túnel SSH).
# Para publicarlo en https://PANEL_DOMAIN con usuario y contraseña (Caddy + Let's Encrypt),
# descomenta estas líneas. El dominio debe apuntar a la IP del VPS y los puertos 80/443 estar abiertos.
# Genera el hash con:  docker run --rm caddy:2.11.4-alpine caddy hash-password --plaintext 'tu-contraseña'
# COMPOSE_PROFILES=public
# PANEL_DOMAIN=panel.example.com
# PANEL_USER=demo
# PANEL_PASSWORD_HASH='$2a$14$...'
# Opcional: interfaz de Flink en solo lectura, con el mismo usuario y contraseña.
# FLINK_DOMAIN=flink.panel.example.com

{
  "datasets": [
    {
      "name": "kpi",
      "displayName": "kpi",
      "queryLines": [
        "SELECT dt, date_format(dt, 'dd/MM/yyyy') AS fecha, round(sum(ventas_netas), 2) AS ventas,\n",
        "  sum(tickets) AS tickets, sum(unidades) AS unidades, round(sum(ventas_netas) / sum(tickets), 2) AS ticket_medio,\n",
        "  count(*) AS tiendas\n",
        "FROM databrick_graupel_demo.retail_demo.resumen_tienda WHERE dt = (SELECT max(dt) FROM databrick_graupel_demo.retail_demo.resumen_tienda) GROUP BY dt"
      ]
    },
    {
      "name": "top_tiendas",
      "displayName": "top_tiendas",
      "queryLines": [
        "SELECT tienda_id || ' · ' || tienda AS tienda, region, ventas_netas AS ventas\n",
        "FROM databrick_graupel_demo.retail_demo.resumen_tienda WHERE dt = (SELECT max(dt) FROM databrick_graupel_demo.retail_demo.resumen_tienda)\n",
        "ORDER BY ventas_netas DESC LIMIT 15"
      ]
    },
    {
      "name": "tiendas",
      "displayName": "tiendas",
      "queryLines": [
        "SELECT tienda_id, tienda, ciudad, region, formato, ventas_netas, tickets, ticket_medio, top3_productos\n",
        "FROM databrick_graupel_demo.retail_demo.resumen_tienda WHERE dt = (SELECT max(dt) FROM databrick_graupel_demo.retail_demo.resumen_tienda)"
      ]
    },
    {
      "name": "region",
      "displayName": "region",
      "queryLines": [
        "SELECT region, ventas_netas AS ventas, tickets, tiendas\n",
        "FROM databrick_graupel_demo.retail_demo.resumen_region WHERE dt = (SELECT max(dt) FROM databrick_graupel_demo.retail_demo.resumen_region)"
      ]
    },
    {
      "name": "categoria",
      "displayName": "categoria",
      "queryLines": [
        "SELECT categoria, ventas_netas AS ventas, unidades\n",
        "FROM databrick_graupel_demo.retail_demo.resumen_categoria WHERE dt = (SELECT max(dt) FROM databrick_graupel_demo.retail_demo.resumen_categoria)"
      ]
    },
    {
      "name": "calidad",
      "displayName": "calidad",
      "queryLines": [
        "SELECT metrica, valor\n",
        "FROM databrick_graupel_demo.retail_demo.calidad_datos WHERE dt = (SELECT max(dt) FROM databrick_graupel_demo.retail_demo.calidad_datos)"
      ]
    },
    {
      "name": "tienda_producto",
      "displayName": "tienda_producto",
      "queryLines": [
        "SELECT tienda_id || ' · ' || tienda AS tienda, producto, categoria, unidades, tickets,\n",
        "  ventas_netas AS ventas\n",
        "FROM databrick_graupel_demo.retail_demo.ventas_tienda_producto WHERE dt = (SELECT max(dt) FROM databrick_graupel_demo.retail_demo.ventas_tienda_producto)"
      ]
    },
    {
      "name": "historico",
      "displayName": "historico",
      "queryLines": [
        "SELECT dt, round(sum(ventas_netas), 2) AS ventas, sum(tickets) AS tickets,\n",
        "  round(sum(ventas_netas) / sum(tickets), 2) AS ticket_medio\n",
        "FROM databrick_graupel_demo.retail_demo.resumen_tienda GROUP BY dt"
      ]
    },
    {
      "name": "historico_region",
      "displayName": "historico_region",
      "queryLines": [
        "SELECT dt, region, ventas_netas AS ventas FROM databrick_graupel_demo.retail_demo.resumen_region"
      ]
    }
  ],
